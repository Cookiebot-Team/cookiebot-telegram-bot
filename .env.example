# ---- service identity ----
CB_ENV=local
CB_SERVICE_NAME=cb-gateway          # overridden per service
CB_LOG_LEVEL=INFO
CB_LOG_JSON=true

# ---- postgres (single-node citus) ----
CB_PG_DSN=postgresql://cookiebot:cookiebot@localhost:5432/cookiebot
CB_PG_POOL_MIN=4
CB_PG_POOL_MAX=32
CB_PG_COMMAND_TIMEOUT=10.0
# Every service brings the schema to head during startup; replicas serialise on a
# Postgres advisory lock. Set false where a separate migration job owns the schema.
CB_AUTO_MIGRATE=true
CB_MIGRATE_LOCK_TIMEOUT=300
# Empty -> found next to the installed cb-api package.
CB_MIGRATIONS_DIR=
# Shards per distributed table, applied by the migration session so every
# environment gets the same topology. Raise it for a real multi-node cluster.
CB_CITUS_SHARD_COUNT=8

# ---- valkey (cache / cooldowns / arq queue) ----
CB_REDIS_DSN=redis://localhost:6379/0

# ---- blob storage ----
# s3://bucket/prefix | gs://bucket/prefix | file:///var/lib/cookiebot/media | memory://
# Credentials resolve the same way each cloud's own SDK resolves them:
#   S3  -> AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION, or an instance role
#   GCS -> GOOGLE_APPLICATION_CREDENTIALS, or workload identity
CB_STORAGE_URI=memory://
CB_STORAGE_SIGNED_URL_TTL=3600

# ---- llm ----
# Leave the key empty to fall back to the SDK's own resolution
# (ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or an `ant auth login` profile).
CB_ANTHROPIC_API_KEY=
CB_OPENAI_API_KEY=
# Point at ollama / vLLM / openrouter to self-host; leave empty for api.openai.com
CB_OPENAI_BASE_URL=
CB_LLM_TIMEOUT_SECONDS=60
# Re-serve a safety-declined request on a fallback model inside the same call.
CB_LLM_REFUSAL_FALLBACK=true
CB_LLM_ALLOW_AMBIENT_CREDENTIALS=true
# Per-task model choice. Omitted tasks fall back to cb_core.llm.router:DEFAULT_TASKS.
# "chat" runs behind the langchain provider (x_conversational_ai R1.8) --
# `model` is a fully qualified "provider:model" string, not a bare model id
# like the other tasks below. Copying this example with the old
# "provider":"anthropic" shape for "chat" opts back out of langchain routing.
CB_LLM_TASKS={"chat":{"provider":"langchain","model":"anthropic:claude-opus-5","max_tokens":1024,"temperature":1.0,"timeout":30.0},"moderate":{"provider":"anthropic","model":"claude-haiku-4-5","max_tokens":256,"temperature":0.0},"transcribe":{"provider":"openai","model":"whisper-1"}}
# x_conversational_ai: per-group rate limit on top of v1's per-user streak counter
# and the tenant spend cap. ai_chat_group_limit triggers per ai_chat_window_seconds.
CB_AI_CHAT_GROUP_LIMIT=20
CB_AI_CHAT_WINDOW_SECONDS=60

# ---- x_speech_to_text ----
# Duration cap checked against message.voice.duration before any download.
# The transcription timeout is DEFAULT_TASKS["transcribe"].timeout, already
# overridable via CB_LLM_TASKS above -- not a separate setting.
CB_TRANSCRIBE_MAX_DURATION_SECONDS=300

# ---- util_youtube ----
# YouTube Data API v3 key (console.cloud.google.com). Empty means /youtube
# always answers youtube_no_find -- see cb_worker/jobs/youtube.py.
CB_YOUTUBE_API_KEY=
CB_YOUTUBE_TIMEOUT_SECONDS=5

# ---- x_image_search ----
# Google Programmable Search: an API key and the search-engine id (v1's
# searchEngineCX). Both required; either empty and every unrecognised /command
# answers anything_no_find -- see cb_worker/jobs/image_search.py.
CB_GOOGLE_SEARCH_API_KEY=
CB_GOOGLE_SEARCH_CX=
CB_GOOGLE_SEARCH_TIMEOUT_SECONDS=5
# v1's daily caps (Cooldowns.py:6-7). v1 counted them per process across five
# processes; these are shared across every replica.
CB_IMAGE_SEARCH_DAILY_PER_USER=15
CB_IMAGE_SEARCH_DAILY_TOTAL=180

# ---- x_reverse_search ----
# SauceNAO API key (saucenao.com/user.php). Empty means /buscarfonte always
# answers reverse_no_found -- see cb_worker/jobs/reverse_search.py.
CB_SAUCENAO_API_KEY=
CB_SAUCENAO_TIMEOUT_SECONDS=15

# ---- util_birthday ----
# The daily every-group birthday post. On by default because v1 does it
# (COOKIEBOT.py:333-339, from the message handler's `finally` on the first
# update of a new UTC day). Set false to keep only the manual /birthday.
CB_BIRTHDAY_BROADCAST_ENABLED=true

# ---- core_musicdetection ----
# Off by default: it fingerprints EVERY voice note in a group with utility
# functions on, which makes it the highest-volume outbound call in the bot.
# v1 used Shazam's unpublished endpoint; v2 uses AudD's documented one --
# see cb_worker/music.py for why the vendor changed. Empty key means the
# feature is inert even when the flag is on.
CB_MUSIC_DETECTION_ENABLED=false
CB_AUDD_API_KEY=
CB_MUSIC_DETECTION_TIMEOUT_SECONDS=20

# ---- x_distortion ----
# How many /destroy jobs one cb-worker runs at once. v1's bound was exactly one
# per media class, enforced by spinning on a module global (FEATURE-MAP D3);
# this is the same bound as a real semaphore. Needs ffmpeg on PATH for the
# audio arm -- the cb-worker image installs it (Dockerfile:203).
CB_DISTORTION_CONCURRENCY=2

# ---- util_postforwarder / util_postgetter ----
# v1 hardcoded one deployment's channels (Bot/Publisher.py:20-22). Leave these
# unset and the publisher is inert: /publish and /repost answer
# publisher_unavailable and nothing is ever scheduled. That is deliberate --
# a publisher network with no Mural to render into is worse than none.
#   v1's values, for reference: -1001869523792 / -1001659344607
CB_POSTMAIL_CHAT_ID=0
CB_POSTMAIL_CHAT_LINK=
CB_APPROVAL_CHAT_ID=0
# Author names whose "contact the poster" button is suppressed. v1 hardcoded
# the single name "Mekhy" (Publisher.py:197); the default reproduces it.
CB_PUBLISHER_HIDDEN_AUTHOR_NAMES=["Mekhy"]
CB_PUBLISHER_PENDING_TTL_SECONDS=86400
# exchangerate-api.com v6 key. Empty means ad prices are left as written,
# which is also what v1 did whenever the call failed (Publisher.py:171-172).
CB_EXCHANGERATE_API_KEY=
CB_EXCHANGERATE_TIMEOUT_SECONDS=10

# ---- telemetry ----
CB_OTLP_ENDPOINT=http://localhost:4317
CB_TRACES_ENABLED=true
CB_TRACE_SAMPLE_RATIO=1.0
CB_METRICS_PORT=9101
PROMETHEUS_MULTIPROC_DIR=/tmp/cb-prom

# ---- telegram ----
# JSON map: skin key -> bot token. One gateway process serves every skin.
CB_BOT_TOKENS={"cookiebot":"123:REPLACE","bombot":"456:REPLACE"}
# Sent by Telegram as X-Telegram-Bot-Api-Secret-Token; rejects forged webhook posts.
CB_WEBHOOK_SECRET=change-me-32-bytes
CB_WEBHOOK_BASE_URL=https://bot.example.net
# Point at the mock Telegram API in tests; empty = real api.telegram.org.
# For a self-hosted server (docker compose --profile selfhosted up -d):
#   CB_TELEGRAM_API_BASE=http://localhost:8082
#   CB_TELEGRAM_API_LOCAL=true
CB_TELEGRAM_API_BASE=
CB_TELEGRAM_API_LOCAL=false
CB_TELEGRAM_API_FILE_BASE=
# Only when the server's /var/lib/telegram-bot-api is mounted elsewhere here.
CB_TELEGRAM_FILES_ROOT=
# webhook (production) | polling (dev, or self-hosted with no public URL) | websocket (reserved)
CB_TELEGRAM_INGEST=webhook
CB_TELEGRAM_POLLING_TIMEOUT=30

# Application credentials for the self-hosted Bot API server (my.telegram.org).
# Read by docker compose, not by the bot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

CB_OWNER_ID=0

# Telegram file_id for the "how to turn off anonymous mode" video the /config
# denial branch sends (v1 shipped it as Static/remove_anonymous_tutorial.mp4).
# Empty = the video is not sent; nothing is uploaded and no URL is guessed.
CB_ANONYMOUS_TUTORIAL_FILE_ID=

# ---- v1 data import (cb_worker.importer) ----
# Exactly one source: a live v1 MongoDB, or a `mongodump` directory. Setting both
# is refused rather than silently preferring one. The URI carries credentials and
# is never logged.
#   docker compose --profile v1data up -d     # a local Mongo to import from
CB_MONGO_URI=
CB_MONGO_DATABASE=cookiebot
CB_MONGO_DUMP_DIR=
CB_IMPORT_BATCH_SIZE=500

# ---- local sandbox (telegram-sandbox, a separate repository) ----
# DuckDB file holding the sandbox world: users, groups, memberships, messages and
# the bot's API-call log. Survives a restart; `Reset` in the UI clears it.
# Read by the sandbox process itself, not by any Cookiebot service — see
# docs/SANDBOX.md.
TG_SANDBOX_DB=sandbox.duckdb

# ---- x_webhub_login: the web console's Telegram-login token exchange ----
# v1 generated the RSA signing key at import, per gunicorn worker, on every
# start (FEATURE-MAP D7): tokens stopped verifying on restart, and with two
# workers the published JWKS described only one of the two live keys. Leave
# this empty and cb-api generates a key **once** into `signing_keys` and every
# replica shares it. Set it (a PKCS#8 PEM) to keep the private key out of the
# application database entirely — the table is then never read or written.
CB_WEBHUB_JWT_PRIVATE_KEY_PEM=
# v1's literal key id (Server.py:23). Changing it starts a rotation.
CB_WEBHUB_JWT_KID=cookiebot-2025
# v1's 30 minutes.
CB_WEBHUB_TOKEN_TTL_SECONDS=1800
# `iss`, and the base of /.well-known/openid-configuration. **Set this.** Unset
# reproduces v1, whose issuer was `request.url_root` — behind a proxy that is
# the X-Forwarded-Host header, so a caller chooses the issuer of the tokens
# this service mints.
CB_WEBHUB_ISSUER=
# How old Telegram's `auth_date` may be, in seconds. 0 reproduces v1, which
# never checked it, so a captured login payload mints tokens forever. Any real
# value logs out every WebHub session whose stored payload is older than the
# window, because the shipped client renews by re-posting it rather than
# re-running the login widget — change the client first.
CB_WEBHUB_AUTH_MAX_AGE_SECONDS=0
# Browser origins allowed to call /login. v1 shipped origins="*".
# JSON list, e.g. ["https://cookiebot.example"]
CB_WEBHUB_ALLOWED_ORIGINS=[]

# ---------------------------------------------------------------------------
# x_miniapp_auth — the OAuth2 token endpoint the Telegram Mini App uses.
# Net-new: v1 had no Mini App. Access tokens are the same RS256 JWTs /login
# mints, signed by the keys above and published by the same JWKS; what is new
# is that they carry scopes, expire quickly and have a rotating refresh token
# behind them. See docs/site/content/docs/miniapp-api.mdx.
# ---------------------------------------------------------------------------
# Access-token life. Short on purpose: a Mini App holds it in memory and
# refreshes, unlike the console, which stores a 30-minute token.
CB_MINIAPP_ACCESS_TOKEN_TTL_SECONDS=900
# Refresh-token life. A session idle for a week logs in again — inside
# Telegram that is one tap.
CB_MINIAPP_REFRESH_TOKEN_TTL_SECONDS=604800
# How old the `auth_date` inside `initData` may be. Unlike the widget's window
# above this one is **on**: there is no v1 behaviour to preserve, initData is
# reissued every time the Mini App opens, and a captured payload that mints
# tokens forever is what this prevents. 0 disables it.
CB_MINIAPP_INIT_DATA_MAX_AGE_SECONDS=86400
# `aud` on Mini App tokens, and what a resource server may pin.
CB_MINIAPP_AUDIENCE=cookiebot-miniapp
# What a Mini App session may do. Reading and writing a group's settings are
# separate scopes, so a read-only Mini App is one string shorter.
# JSON list.
CB_MINIAPP_SCOPES=["groups:read","groups:write","audit:read"]
