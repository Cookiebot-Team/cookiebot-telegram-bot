__pycache__/
*.py[cod]
*.so
*.c
# Cython's `annotate=True` output, next to the module it annotates.
*.html
!ops/**/*.html
# The generated API reference IS committed: it is published with the docs site,
# `scripts/api_spec.py generate --check` fails when it is stale, and a fresh
# clone should be able to read the API without building anything.
!docs/site/public/api-reference/*.html
.venv/
uv.lock.bak
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.env
/tmp/

# any stray npm/bun install, anywhere
node_modules/

# docs site (Fumadocs) — `content/progress.json` IS committed: it is the
# generated evidence the site renders, and a clone should show real numbers
# before anyone runs the suite.
docs/site/node_modules/
docs/site/.next/
docs/site/out/
docs/site/next-env.d.ts
docs/site/tsconfig.tsbuildinfo
docs/site/.source/

# sandbox world (regenerated by seeding)
sandbox.duckdb
sandbox.duckdb.wal

# what `cb.py test-e2e` recorded, kept after the run so the UI can open it
# (qa/e2e/conftest.py `_run_db_path`); wiped at the start of the next run
sandbox-e2e.duckdb
sandbox-e2e.duckdb.wal

# HyperFrames video projects: the composition, its captured assets and the
# brief are source; renders, snapshots and the preview cache are output.
videos/*/renders/
videos/*/snapshots/
videos/*/node_modules/
videos/*/.hyperframes/
demo.duckdb
demo.duckdb.wal
videos/*/.media/

# what `scripts/qa_setup.py` keeps between runs: the background API's pid and
# log, and the last session's tokens. Tokens, so never committed.
.qa/
