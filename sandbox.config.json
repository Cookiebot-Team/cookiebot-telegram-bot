    {
      "id": "anon-admin",
      "button": "Anonymous admin -> /config",
      "label": "Anonymous admin bypass",
      "seed": "default",
      "feature_id": "util_config",
      "acting_user": "carol",
      "what_to_do": "Acting as Carol, send /config.",
