    {
      "id": "D1",
      "text": "Write calls share the read memo-cache; duplicate writes silently no-op",
      "addressed": true
    },
    {
      "id": "D2",
      "text": "verify=False on every backend call",
      "addressed": true
    },
    {
      "id": "D3",
      "text": "Busy-wait spin lock serialises all media distortion",
      "addressed": false
    },
    {
      "id": "D4",
      "text": "Fixed temp filenames raced across 50 threads",
      "addressed": true
    },
    {
      "id": "D5",
      "text": "Shared unlocked SQLite connection",
      "addressed": true
    },
    {
      "id": "D6",
      "text": "Unbounded, unlocked, never-expiring caches",
      "addressed": true
    },
    {
      "id": "D7",
      "text": "JWT signing key regenerated on every restart",
